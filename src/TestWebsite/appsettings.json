{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "a89171cd-8842-4bcd-a069-cf462a86eecf"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },



  "DotSee": {
    "ResponsiveImages": {
      "LazyLoad": {
        "EnablelazyLoad": true,
        "PreviewType": "Blur",
        "LowResImagePath": "/img/placeholder-lowres.jpg"
      },
      "RuleSets": [
        {
          "Name": "defaultset",
          "OriginalImageMaxWidth": 1920,
          "ImageQuality": 70,
          "UseBreakPointWidthIfNoWidth": false,
          //"LazyLoad": true,
          "CropMode": "Crop",
          "Breakpoints": [
            {
              "BreakPointWidth": 1920,
              "Width": 400,
              "Height": 400
            },
            {
              "BreakPointWidth": 1600,
              "Width": 400,
              "Height": 400
            },
            {
              "BreakPointWidth": 1440,
              "Width": 400,
              "Height": 400
            },
            {
              "BreakPointWidth": 1200,
              "Width": 400,
              "Height": 400
            },
            {
              "BreakPointWidth": 992,
              "Width": 400,
              "Height": 400
            },
            {
              "BreakPointWidth": 768,
              "Width": 400,
              "Height": 400
            },
            {
              "BreakPointWidth": 576,
              "Width": 400,
              "Height": 400
            },
            {
              "BreakPointWidth": 400,
              "Width": 400,
              "Height": 400
            },
            {
              "BreakPointWidth": 320,
              "Width": 320,
              "Height": 400
            }
          ]
        }
      ]
    }
  }



}



