@using DotSee.ResponsiveImages;
@using Umbraco.Cms.Core.Models;
@using Umbraco.Extensions;

@inject SrcSetManager _ssm

@inherits Umbraco.Cms.Web.Common.Macros.PartialViewMacroPage

@{
    var images = Model.MacroParameters["image"].ToString().Split(',');
    var ruleSet = Model.MacroParameters["ruleSet"].ToString();
    var alt = Model.MacroParameters["alt"].ToString();

    if (string.IsNullOrEmpty(ruleSet))
    { 
        ruleSet = "defaultset";
    }

    foreach (var img in images)
    {
        var imageObj = Umbraco.Media(img);

        var cropsObj = new MediaWithCrops(imageObj, null, null);
        if (UmbracoContext.IsFrontEndUmbracoRequest())
        {
            @_ssm.CreatePictureElement(cropsObj, ruleSet, alt)
        }
        else
        {
            var imgUrl = imageObj.GetCropUrl(width: 500);
            <img src="@imgUrl" alt="@alt">
        }
    }
}



